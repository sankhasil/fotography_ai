# Copy to .env and edit. Never commit real paths.
#
# The folder containing your .nef files. Mounted read-only into the renderer.
PHOTOS_DIR=/Users/A200173944/Pictures/Nikon Transfer 2/FotoDump

# Where the host-side Adobe DNG Converter writes intermediate .dng files.
# Defaults to ./out when unset.
DNG_DIR=./out

# Where exported .jpg files land. Defaults to ./out when unset.
EXPORT_DIR=./out